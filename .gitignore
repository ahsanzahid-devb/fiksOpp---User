# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Secrets & signing — NEVER commit (rotate if ever pushed to remote)
*.p8
AuthKey_*.p8
**/key.properties
**/*.jks
**/*.keystore

# Local tooling venv (icon generation)
.venv_icon/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/

# iOS generated (do NOT ignore ios/Podfile, ios/Runner/, ios/Flutter/*.xcconfig)
# Regenerate: flutter pub get && cd ios && pod install
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/ephemeral/
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols
# Gradle (add this section)
.gradle/
*.lock
**/checksums/

# Android Gradle specific
/android/.gradle/
/android/local.properties
/android/captures/
/android/build/
/android/app/build/
/android/build/ios/
# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
